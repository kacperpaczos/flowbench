          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const pomiary = $input.first().json.pomiary || [];\nif (pomiary.length === 0) {\n  return [{ json: { liczbaMiast: 0, sredniaTemperaturaC: null, uwaga: \"Brak danych wejsciowych\" } }];\n}\nconst suma = pomiary.reduce(function (acc, p) { return acc + Number(p.temperaturaC); }, 0);\nconst srednia = suma / pomiary.length;\nreturn [{\n  json: {\n    miasta: pomiary.map(function (p) { return p.miasto; }),\n    pomiary: pomiary,\n    liczbaMiast: pomiary.length,\n    sredniaTemperaturaC: Math.round(srednia * 100) / 100\n  }\n}];"
