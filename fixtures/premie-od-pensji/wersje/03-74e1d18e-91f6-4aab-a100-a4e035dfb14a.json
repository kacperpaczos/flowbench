          "jsCode": "const items = $input.all();\nconst sumaPensji = items.reduce((a, i) => a + i.json.pensja, 0);\nconst sumaPremii = items.reduce((a, i) => a + i.json.premia, 0);\nconst sumaDodatkow = items.reduce((a, i) => a + i.json.dodatek, 0);\nconst sumaPremiiRazem = items.reduce((a, i) => a + i.json.premiaRazem, 0);\nreturn [{ json: {\n  liczbaPracownikow: items.length,\n  sumaPensji: Math.round(sumaPensji * 100) / 100,\n  sumaPremii: Math.round(sumaPremii * 100) / 100,\n  sumaDodatkow: Math.round(sumaDodatkow * 100) / 100,\n  sumaPremiiRazem: Math.round(sumaPremiiRazem * 100) / 100,\n  szczegoly: items.map(i => ({ imie: i.json.imie, pensja: i.json.pensja, premia: i.json.premia, dodatek: i.json.dodatek, premiaRazem: i.json.premiaRazem }))\n} }];",
